*.ply
*.mp4
*.urdf
*.obj
*.safetensors
*.pt
*.pth

/configs/runtime.local.json

# ---- local worktrees, build products and retained review assets ----
/worktrees/
/demo
/docs/project_overview
/dist/
/build/
/.t/
.pytest_cache/
.ruff_cache/

# ---- local credentials ----
.env
.env.*
!.env.example

