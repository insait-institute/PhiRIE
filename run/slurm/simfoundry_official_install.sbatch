#!/bin/bash
#SBATCH --partition=batch
#SBATCH --qos=normal
#SBATCH --gres=gpu:a6000:1
#SBATCH --mem=64G
#SBATCH --cpus-per-task=8
#SBATCH --time=08:00:00
#SBATCH --job-name=simfoundry_install
#SBATCH --output=/group/worldcept/PhiRIE/code/SimAny/outputs/simfoundry_official/install_%j.log

# Stage 2 of the official-SimFoundry integration attempt (docs/BASELINES.md
# "CORRECTED 2026-08-31", docs/ICRA_RESEARCH_CONTRACT.md correction #14).
# Builds ONLY the 4 envs Pipeline A actually needs (skips the opt-in
# auto-background trio void/nerfstudio/3dgrut, per AGENT_INSTALL.md section 2
# "Core reconstruction only"), against the vendored clone at
# third_party/SimFoundry (untracked, matches this repo's third_party/*
# .gitignore convention).
#
# `mamba` is not installed on this cluster; ~/bin/mamba is a shim added this
# session that execs the /usr/bin/micromamba already present on every node
# (2.9.0, command-compatible for create/run/shell-hook -- verified before
# this job was submitted). /usr/local/cuda-12.8 does not exist anywhere on
# this cluster either, but install_any6d.sh already falls back to `nvcc` on
# PATH, so `module load nvidia-cuda-12.8.1` (same version other run/slurm/*
# scripts on this repo use, e.g. paired_matrix.sbatch's
# CUDA_HOME=/opt/modules/nvidia-cuda-12.8.1) avoids its slower
# self-install-into-the-env fallback.
#
# PIP "DNS STORM" ROOT CAUSE (diagnosed 2026-09-01, after jobs 795233 and
# 795333 both drowned in "[Errno -2] Name or service not known" pip retry
# warnings): the hostname `pypi.ngc.nvidia.com` -- baked into this cluster's
# SITE-WIDE /etc/pip.conf as extra-index-url (autogenerated by "NVIDIA
# PyIndex" long ago) -- is permanently dead: it fails DNS resolution from
# every node checked (login AND compute; NVIDIA retired the NGC PyPI
# mirror). pip queries EVERY configured index for EVERY package, so each
# package first burns its entire retry budget (with exponential backoff)
# against the dead host before quietly succeeding via pypi.org. The two
# prior readings of the logs were both wrong in instructive ways:
#   - it was never node/cgroup/resolver degradation (an interactive shell
#     resolving pypi.org fine during a "storm" is expected -- pypi.org was
#     never the failing name; pip's warning lines show only the URL path,
#     e.g. ": /numpy/", hiding WHICH index host failed);
#   - the earlier PIP_RETRIES=15 "fix" made it far WORSE, not better:
#     urllib3's backoff grows exponentially (capped at 120s/step), so 15
#     retries against a dead host is ~10+ minutes of sleeping PER REQUEST,
#     which is why 795333 looked completely stalled for its full hour.
# Verified fix: PIP_CONFIG_FILE=/dev/null makes pip ignore the site config
# entirely (default index-url is pypi.org anyway, and it also re-enables
# the wheel cache that the site config disables). Measured on a compute
# node: 5 packages in 14s with 0 retry warnings, vs 9-25s each with ~5
# warnings under the site config. Installer-internal `--extra-index-url`
# command-line flags (blender pypi, torch_packages_builder) are unaffected.
# The retry loop below is kept as cheap defense-in-depth against GENUINE
# transient network trouble: on failure it removes ONLY the env that was
# mid-build when the attempt died (from the attempt's own ">>> [name]"
# markers, per AGENT_INSTALL.md's "installer stops partway" gotcha), never
# a blind --fresh rebuild.

set -uo pipefail  # NOT -e: the retry loop below needs to see install_everything.sh's
                   # exit code, not have the script die out from under it.

export PATH="$HOME/bin:$PATH"
export PIP_CONFIG_FILE=/dev/null

# CUDA-ENV SANITIZATION (added after attempt job 800313 failed on da3):
# sbatch copies the SUBMISSION shell's environment, and this login session
# leaks an old module load (CUDA_HOME/CUDA_PATH/LD_LIBRARY_PATH ->
# /opt/modules/nvidia-cuda-12.4.1, plus gcc-11.5.0 module markers) -- the
# exact leak docs/POLARIS_INTEGRATION.md already documents for this cluster.
# torch.utils.cpp_extension._find_cuda_home prefers $CUDA_HOME over `which
# nvcc`, so install_da3.sh's xformers source build used the leaked nvcc
# 12.4.1 (which rejects gcc>=14: "unsupported GNU version") instead of the
# cuda-toolkit 12.8 the installer had JUST put into the env. install_any6d.sh
# survived only because it explicitly re-exports CUDA_HOME itself;
# install_da3.sh never touches it. Deterministic, so retries cannot fix it --
# strip the leak and let each installer's own self-installed toolkit win.
unset CUDA_HOME CUDA_PATH PKG_CONFIG_PATH MODULES_CURRENTLY_ACTIVE
export LD_LIBRARY_PATH="$(echo "${LD_LIBRARY_PATH:-}" | tr ':' '\n' | grep -v '/opt/modules/nvidia-cuda' | paste -sd:)"
export PATH="$(echo "$PATH" | tr ':' '\n' | grep -v '/opt/modules/nvidia-cuda' | paste -sd:)"

echo "=== $(date -u) preflight ==="
command -v mamba && mamba --version
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv
which nvcc && nvcc --version | tail -1
df -h /group/worldcept | tail -1
echo "PIP_CONFIG_FILE=${PIP_CONFIG_FILE} (site pip.conf bypassed -- dead NGC extra index)"
getent hosts pypi.ngc.nvidia.com >/dev/null 2>&1 && echo "NOTE: pypi.ngc.nvidia.com resolves again -- site pip.conf may be usable now" || echo "confirmed: pypi.ngc.nvidia.com still dead (expected)"

cd /group/worldcept/PhiRIE/code/SimAny/third_party/SimFoundry

MAX_ATTEMPTS=4
RETRY_SLEEP_S=180
ATTEMPT=1
STATUS=1
while [ "$ATTEMPT" -le "$MAX_ATTEMPTS" ]; do
  echo "=== $(date -u) attempt ${ATTEMPT}/${MAX_ATTEMPTS}: install_everything.sh --only \"simfoundry hunyuan any6d da3\" ==="
  ATTEMPT_LOG="$(mktemp)"
  bash scripts/installation/install_everything.sh --only "simfoundry hunyuan any6d da3" 2>&1 | tee "$ATTEMPT_LOG"
  STATUS=${PIPESTATUS[0]}
  echo "=== $(date -u) attempt ${ATTEMPT} exited ${STATUS} ==="
  if [ "$STATUS" -eq 0 ]; then
    rm -f "$ATTEMPT_LOG"
    break
  fi
  # Identify the exact env that was mid-build when THIS attempt died (its
  # last ">>> [name] script.sh (env: envname)" marker) and remove only that
  # one -- envs from a prior, already-successful attempt must survive so
  # install_everything.sh's own skip-existing-env resumability still applies.
  BROKEN_ENV=$(grep -oP '^>>> \[.*\] .*\(env: \K[^)]+' "$ATTEMPT_LOG" | tail -1)
  rm -f "$ATTEMPT_LOG"
  if [ -n "${BROKEN_ENV:-}" ]; then
    echo "=== $(date -u) attempt ${ATTEMPT} failed mid-build of env '${BROKEN_ENV}'; removing it before retrying ==="
    mamba env remove -n "$BROKEN_ENV" -y 2>&1 || echo "WARN: could not remove ${BROKEN_ENV} (may not have been created yet)"
  else
    echo "=== $(date -u) attempt ${ATTEMPT} failed before any env's install started; nothing to remove ==="
  fi
  ATTEMPT=$((ATTEMPT + 1))
  if [ "$ATTEMPT" -le "$MAX_ATTEMPTS" ]; then
    echo "=== $(date -u) sleeping ${RETRY_SLEEP_S}s to let any transient network/DNS issue clear ==="
    sleep "$RETRY_SLEEP_S"
  fi
done

echo "=== $(date -u) install retry loop finished after ${ATTEMPT} attempt(s), final status ${STATUS} ==="
exit $STATUS
