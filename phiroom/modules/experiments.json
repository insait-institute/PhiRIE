{
  "id": "experiments",
  "branch": "module/experiments-v2",
  "description": "Existing final-experiment and construction entry points",
  "inputs": [
    "frozen cases; protocol; explicit runtime bindings"
  ],
  "outputs": [
    "existing campaign manifests; admission and validation receipts"
  ],
  "tools": [
    "finalize",
    "SimFactory"
  ],
  "actions": {
    "preflight": {
      "kind": "shell",
      "target": "run/campaign/final_preflight.sh",
      "runtime": "control",
      "gpu": false,
      "args": []
    },
    "finalize": {
      "target": "robo.campaign.finalize",
      "runtime": "control",
      "gpu": false,
      "args": []
    },
    "factory": {
      "target": "simfactory.runner",
      "runtime": "control",
      "gpu": false,
      "args": []
    },
    "construct-auto": {
      "kind": "shell",
      "target": "run/run_auto.sh",
      "runtime": "control",
      "gpu": true,
      "args": []
    },
    "construct-gt": {
      "kind": "shell",
      "target": "run/run_factory.sh",
      "runtime": "control",
      "gpu": true,
      "args": []
    },
    "generator-comparison": {
      "target": "robo.campaign.generator_comparison",
      "runtime": "control",
      "gpu": false,
      "args": []
    }
  }
}
