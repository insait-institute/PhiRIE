      "args": []
    },
    "maskclustering": {
      "target": "agents.baselines.maskclustering",
      "runtime": "main",
      "gpu": true,
      "args": []
    },
    "flashsplat": {
      "target": "agents.baselines.flashsplat",
      "runtime": "main",
      "gpu": true,
      "args": []
    }
  }
}
