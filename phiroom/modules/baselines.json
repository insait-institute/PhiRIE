    "single image or reconstructed scene as required by backend"
  ],
  "outputs": [
    "baseline assets; depth or reconstruction outputs"
  ],
  "tools": [
    "SHARP",
    "MaskClustering",
    "FlashSplat"
  ],
  "actions": {
    "single-image-depth": {
      "target": "agents.single_image.sharp_render_depth",
